# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:5205
VITE_ASP_NET_API_BASE_URL=http://localhost:5205

# ASP.NET Core API Configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=LdfProductionDb;User Id=sa;Password=YOUR_SECURE_PASSWORD;TrustServerCertificate=True;

# JWT Authentication
Jwt__Key=YOUR_SECRET_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG
Jwt__Issuer=LdfIssuer
Jwt__Audience=LdfAudience
Jwt__ExpirationMinutes=1440

# Gemini AI Service
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE

# Migration Settings
APPLY_MIGRATIONS=true
